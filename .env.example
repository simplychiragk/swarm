# Swarm Environment Configuration Example
# Copy to .env and supply your API keys. Never commit .env to git.

# Runtime mode: 'mock' (default, automated waitlist demo) or 'live' (agent farm)
SWARM_MODE=mock

# Port for FastAPI WebSocket and HTTP sidecar
SWARM_SIDECAR_PORT=8000

# LLM gateway mode: 'mock' (offline deterministic stub) or 'live' (multi-provider chain)
SWARM_LLM_MODE=mock

# Optional: Pollinations AI provider (enter.pollinations.ai)
POLLINATIONS_API_KEY=
POLLINATIONS_BASE_URL=https://gen.pollinations.ai/v1
POLLINATIONS_MODEL_FAST=openai/gpt-5.4-nano
POLLINATIONS_MODEL_SMART=openai/gpt-5.4-nano

# Primary Provider: NVIDIA NIM API key
NVIDIA_NIM_API_KEY=

# Fallback Provider: OpenRouter API key (supports openai/gpt-5.4-nano, xingchen-agi, etc.)
OPENROUTER_API_KEY=
OPENROUTER_MODEL_FAST=openai/gpt-5.4-nano
OPENROUTER_MODEL_SMART=openai/gpt-5.4-nano

# Optional Bring-Your-Own-Key provider (OpenAI / Anthropic compatible)
BYOK_API_KEY=
BYOK_BASE_URL=

# TinyFish Live Web Research & Browser QA API key (HackIIITD mandatory)
TINYFISH_API_KEY=
